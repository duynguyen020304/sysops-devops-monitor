# ==================================================
# Environment Configuration
# Copy this file to .env and update values for your environment
# ==================================================

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=monitoring
DB_USER=postgres
DB_PASSWORD=CHANGE_ME

# Connection string (full override - if set, overrides individual DB_* vars)
# CONNECTION_STRING=Host=localhost;Port=5432;Database=monitoring;Username=postgres;Password=CHANGE_ME

# Redis (workflow log hot cache; DB remains source of truth)
REDIS_CONNECTION=localhost:6379
Redis__Enabled=true
Redis__InstanceName=monitoring
Redis__WorkflowLogTtlHours=24

# JWT
JWT_SECRET_KEY=CHANGE_ME_AT_LEAST_32_CHARS!
JWT_ISSUER=MonitoringPlatform
JWT_AUDIENCE=MonitoringPlatformUsers
JWT_EXPIRES_IN_MINUTES=60

# Agent
AGENT_TOKEN=CHANGE_ME


# Super Admin Seed (used on first startup only, skipped if user already exists)
SUPER_ADMIN_EMAIL=admin@monitoring.local
SUPER_ADMIN_PASSWORD=  # REQUIRED — set a strong password

# Deploy
DEPLOY_AGENT_BUILD_PATH=agent
DEPLOY_AGENT_REMOTE_PATH=/opt/monitoring-agent
DEPLOY_AGENT_API_URL=http://localhost:5000
DEPLOY_AGENT_TOKEN=CHANGE_ME

# Logging
LOG_LEVEL_DEFAULT=Information
LOG_LEVEL_MICROSOFT=Warning
